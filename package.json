{
  "name": "gestfacturation-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @gestfacturation/web dev",
    "dev:desktop": "pnpm --filter @gestfacturation/desktop dev",
    "dev:api": "pnpm --filter @gestfacturation/api dev",
    "build": "pnpm --filter @gestfacturation/shared build && pnpm --filter @gestfacturation/web build",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/vite": "^4.2.3",
    "tailwindcss": "^4.2.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/merriweather": "^5.2.6",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "lucide-react": "^1.8.0",
    "tw-animate-css": "^1.4.0"
  }
}
