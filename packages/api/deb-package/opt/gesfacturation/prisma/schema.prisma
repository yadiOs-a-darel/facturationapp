generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  logo           String?
  primaryColor   String?         @default("#1976d2")
  secondaryColor String?         @default("#ffffff")
  fontFamily     String?         @default("Inter")
  legalName      String?
  taxNumber      String?
  address        String?
  city           String?
  country        String?         @default("DZ")
  phone          String?
  email          String?
  website        String?
  plan           PlanType        @default(BASIC)
  planStatus     PlanStatus      @default(TRIAL)
  trialEndsAt    DateTime?
  subscriptionEndsAt DateTime?
  maxUsers       Int             @default(3)
  maxProducts    Int             @default(500)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  customers      Customer[]
  suppliers      Supplier[]
  products       Product[]
  categories     Category[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  expenses       Expense[]
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  paymentMethods PaymentMethod[]
  attachments    Attachment[]
  numbering      NumberingConfig[]
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

enum PlanStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatar       String?
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invoices     Invoice[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
}

model Customer {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  code            String
  type            CustomerType @default(RETAIL)
  denomination    String
  contactName     String?
  email           String?
  phone           String?
  phone2          String?
  address         String?
  city            String?
  wilaya          String?
  country         String?      @default("DZ")
  taxNumber       String?
  discountRate    Float?       @default(0)
  creditLimit     Float?       @default(0)
  paymentTermDays Int?         @default(30)
  currency        String?      @default("DZD")
  isActive        Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoices        Invoice[]

  @@unique([tenantId, code])
}

enum CustomerType {
  WHOLESALE
  RETAIL
  ORGANIZATION
  MINISTRY
  OTHER
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  taxNumber      String?
  paymentTermDays Int?    @default(30)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  name      String
  code      String?
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  products  Product[]

  @@unique([tenantId, name])
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  code           String
  barcode        String?
  name           String
  description    String?
  unit           String          @default("pcs")
  purchasePrice  Float           @default(0)
  sellingPrice   Float           @default(0)
  taxRate        Float           @default(19)
  discountRate   Float           @default(0)
  stockQuantity  Float           @default(0)
  stockMin       Float           @default(0)
  stockMax       Float?
  stockLocation  String?
  image          String?
  isActive       Boolean         @default(true)
  isService      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseOrderItem[]
  stockMovements StockMovement[]
  priceHistory   ProductPriceHistory[]

  @@unique([tenantId, code])
}

model StockMovement {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  type      MovementType
  quantity  Float
  unitCost  Float?
  reason    String?
  reference String?
  createdAt DateTime     @default(now())
  createdBy String?
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  number         String
  type           InvoiceType   @default(INVOICE)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  deliveryDate   DateTime?
  status         InvoiceStatus @default(DRAFT)
  subtotalHT     Float         @default(0)
  discountAmount Float         @default(0)
  discountRate   Float         @default(0)
  taxAmount      Float         @default(0)
  totalTTC       Float         @default(0)
  paidAmount     Float         @default(0)
  paymentMethod  String?
  paymentDate    DateTime?
  paymentRef     String?
  notes          String?
  internalNotes  String?
  terms          String?
  isBackdated    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([tenantId, number])
}

enum InvoiceType {
  INVOICE
  PROFORMA
  QUOTE
  CREDIT_NOTE
  DELIVERY_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Float
  unit        String?  @default("pcs")
  unitPrice   Float
  discountRate Float   @default(0)
  taxRate     Float    @default(19)
  totalHT     Float
  totalTTC    Float
  order       Int      @default(0)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Float
  method    String
  reference String?
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  number       String
  status       POStatus @default(DRAFT)
  orderDate    DateTime @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotalHT   Float    @default(0)
  taxAmount    Float    @default(0)
  totalTTC     Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        PurchaseOrderItem[]

  @@unique([tenantId, number])
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIAL
  CANCELLED
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  description     String
  quantity        Float
  receivedQty     Float         @default(0)
  unitPrice       Float
  taxRate         Float         @default(19)
  totalHT         Float
}

model Expense {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  title     String
  category  String
  amount    Float
  date      DateTime
  method    String?
  reference String?
  notes     String?
  createdAt DateTime @default(now())
}

model Subscription {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  plan       PlanType
  amount     Float
  currency   String   @default("DZD")
  startDate  DateTime
  endDate    DateTime
  status     String
  paymentRef String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String   // ex: CASH, CHEQUE, TRANSFER
  label     String   // ex: Espèces, Chèque, Virement
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model NumberingConfig {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  documentType String   // INVOICE, PURCHASE_ORDER, DELIVERY_NOTE...
  prefix       String   // FAC-2026-
  currentNumber Int     @default(0)
  padding      Int      @default(4) // nombre de chiffres, ex: 0001
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, documentType])
}

model Attachment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  resource     String   // Invoice, Product, Expense...
  resourceId   String
  fileName     String
  url          String
  mimeType     String?
  createdAt    DateTime @default(now())
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Float
  newPrice    Float
  changedAt   DateTime @default(now())
  changedById String?
}
