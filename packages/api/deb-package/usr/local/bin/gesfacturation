#!/bin/bash
#
# GestFacturation - CLI de gestion de l'API
#

set -e

SERVICE_NAME="gesfacturation"
INSTALL_DIR="/opt/gesfacturation"
LOG_FILE="/var/log/gesfacturation/api.log"
ERROR_LOG="/var/log/gesfacturation/api.error.log"

show_help() {
    cat << EOF
GestFacturation API - Commandes disponibles

Usage: gesfacturation <commande>

Commandes:
  start       Démarrer le service
  stop        Arrêter le service
  restart     Redémarrer le service
  status      Afficher l'état du service
  logs        Voir les logs en temps réel
  errors      Voir les erreurs récentes
  reload      Recharger la configuration

Exemples:
  gesfacturation status
  gesfacturation logs
  gesfacturation restart

EOF
}

case "${1:-status}" in
    start)
        echo "Démarrage de GestFacturation API..."
        systemctl start $SERVICE_NAME
        echo "✓ Service démarré"
        ;;
    stop)
        echo "Arrêt de GestFacturation API..."
        systemctl stop $SERVICE_NAME
        echo "✓ Service arrêté"
        ;;
    restart)
        echo "Redémarrage de GestFacturation API..."
        systemctl restart $SERVICE_NAME
        echo "✓ Service redémarré"
        ;;
    reload)
        echo "Rechargement de la configuration..."
        systemctl reload $SERVICE_NAME
        echo "✓ Configuration rechargée"
        ;;
    status)
        systemctl status $SERVICE_NAME --no-pager
        ;;
    logs)
        if [ -f "$LOG_FILE" ]; then
            tail -f "$LOG_FILE"
        else
            journalctl -u $SERVICE_NAME -f
        fi
        ;;
    errors)
        if [ -f "$ERROR_LOG" ]; then
            tail -100 "$ERROR_LOG"
        else
            journalctl -u $SERVICE_NAME -p err -n 100
        fi
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo "Commande inconnue: $1"
        show_help
        exit 1
        ;;
esac
