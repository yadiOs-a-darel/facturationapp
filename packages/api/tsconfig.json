{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@gestfacturation/database/*": [
        "vendor/database/*"
      ]
    }
  },
  "include": [
    "src",
    "src/vendor"
  ]
}
