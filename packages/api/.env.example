# Port de l'API (défaut: 4000)
PORT=4000

# Secret pour signer les JWT tokens (changez-moi en production !)
JWT_SECRET=votre-secret-tres-securise-aleatoire

# URL de connexion à la base de données MySQL
DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/gestfacturation

# Environment: development, production
NODE_ENV=production
